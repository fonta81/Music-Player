/* ======================================================================
   style.tcss — Estilos para el Reproductor MP3 (Textual)
   Paleta: fondo oscuro azulado, acentos cian/verde, tarjetas con bordes
   redondeados sutiles vía "panel" y separación consistente (1-2 celdas).
   ====================================================================== */

/* ----------------------------------------------------------------------
   Variables de color (Textual permite reutilizar los design tokens
   por defecto, pero declaramos algunos alias mentales vía comentarios):
   Fondo base:      #0f1720
   Panel:           #16212b
   Acento primario: #4fd6be (cian)
   Acento éxito:    #57d68d (verde)
   Acento error:    #e5534b (rojo)
   Texto atenuado:  #8a97a3
   ---------------------------------------------------------------------- */

/* ---------- Pantalla general ---------- */
Screen {
    background: #0f1720;
    color: #e6edf3;
}

Header {
    background: #16212b;
    color: #4fd6be;
    text-style: bold;
}

Footer {
    background: #16212b;
    color: #8a97a3;
}

/* ======================================================================
   Contenedor principal
   ====================================================================== */

#main-container {
    height: 1fr;
    padding: 1 2;
}

/* ---------- Panel izquierdo: biblioteca ---------- */
#left-panel {
    width: 2fr;
    height: 100%;
    padding: 1 2;
    margin-right: 2;
    background: #16212b;
    border: round #263341;
}

#library-title {
    margin: 1 0;
    color: #4fd6be;
    text-style: bold;
}

#btn-folder {
    width: 100%;
    background: #1c2a36;
    color: #e6edf3;
    border: tall #2f3f4f;
}

#btn-folder:hover {
    background: #24384a;
    color: #4fd6be;
    border: tall #4fd6be;
}

#playlist {
    height: 1fr;
    margin-top: 1;
    background: #101923;
    border: round #263341;
}

#playlist > .datatable--header {
    background: #1c2a36;
    color: #4fd6be;
    text-style: bold;
}

#playlist > .datatable--cursor {
    background: #234b45;
    color: #ffffff;
    text-style: bold;
}

#playlist > .datatable--hover {
    background: #1a2c33;
}

/* ---------- Panel derecho: info y controles ---------- */
#right-panel {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    background: #16212b;
    border: round #263341;
}

#track-info {
    height: auto;
    min-height: 7;
    padding: 1 2;
    margin-bottom: 1;
    background: #101923;
    border: round #263341;
    color: #e6edf3;
}

/* ---------- Progreso ---------- */
#progress-container {
    height: auto;
    margin-bottom: 1;
    padding: 1 1;
    background: #101923;
    border: round #263341;
}

#progress-container .info-label {
    color: #8a97a3;
    text-style: italic;
    margin-bottom: 1;
}

#progress {
    width: 100%;
}

#progress > .bar--bar {
    color: #4fd6be;
}

#progress > .bar--complete {
    color: #57d68d;
}

/* ---------- Controles de reproducción ---------- */
#controls {
    height: auto;
    align: center middle;
    margin-bottom: 1;
    padding: 1 0;
}

#controls Button {
    min-width: 7;
    margin: 0 1;
    text-style: bold;
}

#btn-prev,
#btn-next {
    background: #1c2a36;
    color: #e6edf3;
    border: tall #2f3f4f;
}

#btn-prev:hover,
#btn-next:hover {
    background: #24384a;
    color: #4fd6be;
    border: tall #4fd6be;
}

#btn-play {
    background: #1c3b2f;
    color: #57d68d;
    border: tall #2f5f4a;
    min-width: 9;
}

#btn-play:hover {
    background: #234a3a;
    border: tall #57d68d;
}

#btn-stop {
    background: #3b1c1c;
    color: #e5534b;
    border: tall #5f2f2f;
}

#btn-stop:hover {
    background: #4a2323;
    border: tall #e5534b;
}

/* ---------- Volumen ---------- */
#volume-container {
    height: auto;
    margin-bottom: 1;
    padding: 1 1;
    background: #101923;
    border: round #263341;
}

#volume-label {
    color: #8a97a3;
    margin-bottom: 1;
}

#volume-bar {
    width: 100%;
}

#volume-bar > .bar--bar {
    color: #4fd6be;
}

#volume-bar > .bar--complete {
    color: #4fd6be;
}

/* ---------- Estado ---------- */
#status {
    width: 100%;
    padding: 1 1;
    background: #101923;
    border: round #263341;
    color: #4fd6be;
    text-style: bold;
    content-align: center middle;
}

/* ======================================================================
   Modal: selección de carpeta
   ====================================================================== */

FolderSelectScreen {
    align: center middle;
}

#dialog {
    width: 70%;
    height: 70%;
    padding: 2 3;
    background: #16212b;
    border: thick #4fd6be;
}

#dialog-title {
    height: auto;
    margin-bottom: 1;
    color: #4fd6be;
    text-style: bold;
}

#dir-tree {
    height: 1fr;
    margin-bottom: 1;
    background: #101923;
    border: round #263341;
    color: #e6edf3;
}

#dir-tree:focus {
    border: round #4fd6be;
}

#dialog-buttons {
    height: auto;
    align: right middle;
}

#dialog-buttons Button {
    min-width: 12;
    margin-left: 2;
}

#btn-select {
    background: #1c3b2f;
    color: #57d68d;
    border: tall #2f5f4a;
}

#btn-select:hover {
    background: #234a3a;
    border: tall #57d68d;
}

#btn-cancel {
    background: #3b1c1c;
    color: #e5534b;
    border: tall #5f2f2f;
}

#btn-cancel:hover {
    background: #4a2323;
    border: tall #e5534b;
}
